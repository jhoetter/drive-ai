# Copy to .env (repo root). `make dev` exports these; `pnpm run dev` also loads this file from
# packages/server/src/main.ts so the API sees DATABASE_URL without using make.
DATABASE_URL=postgres://driveai:driveai@127.0.0.1:35432/driveai
DRIVEAI_PUBLIC_API_URL=http://127.0.0.1:3520
PORT=3520
# Optional: dev user identity when HOF_SUBAPP_JWT_SECRET is unset
DRIVEAI_DEV_USER_ID=u_dev
DRIVEAI_DEV_TENANT_ID=t_dev
# Standalone Vite dev harness (make dev) does NOT send a Bearer — leave this unset, or
# every /api/* call returns 401 and the UI shows a load error. For hofOS, set the same
# secret as the data-app and open Drive via the shell proxy (not this harness), or
# use a small script to attach Authorization: Bearer <minted> for this sidecar.
# HOF_SUBAPP_JWT_SECRET=your-shared-secret
# S3/MinIO (optional — omit to use in-memory blob store for dev)
# S3_ENDPOINT=http://127.0.0.1:39000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=driveai
# S3_SECRET_KEY=driveaidevlocal
# S3_BUCKET=driveai-dev
