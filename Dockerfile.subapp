# Structural WP-4 subapp Dockerfile stub for DriveAI.
# Replace this with the product's production image build once the full
# standalone-subdomain conversion is implemented.
FROM node:20-bookworm-slim
WORKDIR /app
COPY hof-module.json tools.json ./
COPY cli/drive-agent /usr/local/bin/drive-agent
RUN chmod +x /usr/local/bin/drive-agent
ENV HOF_SUBAPP_NAME=driveai HOF_SUBAPP_AUTH_MODE=inherit
EXPOSE 3520
CMD ["sh", "-c", "while true; do sleep 3600; done"]
