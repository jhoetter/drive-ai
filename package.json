{
  "name": "drive-ai",
  "private": true,
  "version": "0.1.0",
  "description": "AI-native Drive-like product layer (sister app for hofOS)",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:push": "pnpm --filter @driveai/db exec drizzle-kit push",
    "build": "turbo run build",
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm --filter @driveai/server dev\" \"pnpm --filter @driveai/web dev\"",
    "dev:turbo": "turbo run dev --filter=@driveai/server --filter=@driveai/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:smoke": "pnpm --filter @driveai/web test:smoke",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hofos:check": "node scripts/check-hofos-ui-contract.mjs",
    "hofos:harness": "HOFOS_MODE=1 pnpm --filter @driveai/web build && node scripts/check-hofos-harness-smoke.mjs",
    "export:hofos-ui": "node scripts/export-hofos-ui.mjs",
    "build:dist": "pnpm --filter @driveai/hofos-ui build:dist"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3"
  }
}
