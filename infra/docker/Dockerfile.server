FROM node:22-bookworm-slim AS builder

ARG DESIGN_SYSTEM=conservative
ENV VITE_DESIGN_SYSTEM=${DESIGN_SYSTEM}

ENV PNPM_HOME=/usr/local/share/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY vendor ./vendor
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts

RUN if [ -f vendor/hofos/use-local-hofos-packages.mjs ]; then \
      node vendor/hofos/use-local-hofos-packages.mjs \
      && pnpm install --no-frozen-lockfile --prefer-offline; \
    else \
      pnpm install --frozen-lockfile --prefer-offline; \
    fi
RUN pnpm --filter @driveai/server... build
RUN pnpm --filter @driveai/web build

FROM node:22-bookworm-slim AS runtime

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl tini \
 && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    PORT=3520 \
    HOF_SUBAPP_NAME=driveai \
    HOF_SUBAPP_AUTH_MODE=inherit \
    PNPM_HOME=/usr/local/share/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app
COPY --from=builder /workspace /app

COPY hof-module.json tools.json /app/
COPY cli/drive-agent /usr/local/bin/drive-agent
RUN chmod +x /usr/local/bin/drive-agent

EXPOSE 3520
HEALTHCHECK --interval=15s --timeout=5s --retries=4 --start-period=20s \
    CMD curl -fsS http://localhost:${PORT}/api/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
# DriveAI workspace packages still export TS source paths, so runtime uses the
# existing tsx-backed server entrypoint until the package exports move to dist.
CMD ["sh", "-c", "pnpm --dir packages/db exec drizzle-kit push && exec pnpm --filter @driveai/server dev"]
