{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "PORT",
    "DATABASE_URL",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_BUCKET",
    "HOF_SUBAPP_JWT_SECRET",
    "DRIVEAI_DEV_USER_ID",
    "DRIVEAI_DEV_TENANT_ID",
    "DRIVEAI_API_URL",
    "VITE_DRIVEAI_API_URL",
    "HOF_OS_PUBLIC_URL",
    "VITE_HOF_OS_PUBLIC_URL",
    "HOFOS_MODE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".turbo/turbo-build.log"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
