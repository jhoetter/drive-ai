{
  "name": "@driveai/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@driveai/activity": "workspace:*",
    "@driveai/core": "workspace:*",
    "@driveai/db": "workspace:*",
    "@driveai/permissions": "workspace:*",
    "@driveai/storage": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.0.1",
    "@types/pdf-parse": "^1.1.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.1.0",
    "jose": "^5.9.6",
    "nanoid": "^5.0.7",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
