#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from datetime import datetime, timezone

VERSION = "0.1.0"


def emit(ok: bool, result: dict, error: str | None = None) -> int:
    print(
        json.dumps(
            {
                "ok": ok,
                "result": result if ok else None,
                "error": error,
                "meta": {
                    "cli": "drive-agent",
                    "version": VERSION,
                    "emitted_at": datetime.now(timezone.utc).isoformat(),
                },
            },
            sort_keys=True,
        )
    )
    return 0 if ok else 1


def main() -> int:
    parser = argparse.ArgumentParser(prog="drive-agent")
    parser.add_argument("--version", action="store_true")
    sub = parser.add_subparsers(dest="group")
    sub.add_parser("status")
    file_cmd = sub.add_parser("file")
    file_sub = file_cmd.add_subparsers(dest="action")
    file_sub.add_parser("list").add_argument("--folder", default="/")
    upload = file_sub.add_parser("upload")
    upload.add_argument("--path", required=True)
    upload.add_argument("--to", default="/")
    file_sub.add_parser("download").add_argument("--key", required=True)
    move = file_sub.add_parser("move")
    move.add_argument("--from", dest="source", required=True)
    move.add_argument("--to", required=True)
    file_sub.add_parser("search").add_argument("--query", required=True)
    folder = sub.add_parser("folder")
    folder_sub = folder.add_subparsers(dest="action")
    folder_sub.add_parser("create").add_argument("--path", required=True)
    args = parser.parse_args()

    if args.version:
        return emit(True, {"version": VERSION})
    if args.group == "status":
        return emit(True, {"module": "driveai", "status": "ready"})
    payload = {"module": "driveai", "group": args.group, "action": getattr(args, "action", None)}
    payload.update({k: v for k, v in vars(args).items() if k not in {"group", "action", "version"}})
    if args.group in {"file", "folder"} and args.action:
        return emit(True, payload)
    parser.print_help()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
